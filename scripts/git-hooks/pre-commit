#!/bin/sh
# Reject a commit that adds words outside a language keyboard, or outside that group's limits.
# When any corpus.txt is staged, refresh Letterix letter frequencies from that index and include them.
cd "$(git rev-parse --show-toplevel)" || exit 1
node scripts/verify-words.js --staged || exit 1
if git diff --cached --name-only --diff-filter=ACMRD | grep -q 'corpus\.txt$'; then
  node scripts/letter-frequency.js letterix --write-staged || exit 1
fi
