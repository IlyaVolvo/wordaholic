{
  "name": "wordaholic",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Offline-first multi-game word platform",
  "scripts": {
    "sync-dicts": "node scripts/sync-dicts.js",
    "build:polywordlot": "vite build --config games/polywordlot/vite.config.ts",
    "build": "node scripts/build.js",
    "build:full": "node scripts/sync-dicts.js && node scripts/build.js",
    "dev": "node scripts/dev.js",
    "dev:polywordlot": "vite --config games/polywordlot/vite.config.ts",
    "serve": "node scripts/serve.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.1",
    "typescript": "^5.2.2",
    "vite": "^6.3.5"
  }
}
