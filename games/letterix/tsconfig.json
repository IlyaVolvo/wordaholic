{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "allowJs": true,
    "paths": {
      "@wordaholic/normalize": ["../../app/i18n/normalize.js"],
      "@wordaholic/storage": ["../../app/storage/idb.js"],
      "@wordaholic/help": ["../../app/help/dialog.js"],
      "@wordaholic/stats": ["../../app/stats/report.js"],
      "@wordaholic/updates": ["../../app/updates/manifest.js"]
    }
  },
  "include": ["src", "../../app/i18n/normalize.js", "../../app/storage/idb.js", "../../app/help/dialog.js", "../../app/stats/report.js", "../../app/updates/manifest.js"]
}
