{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "allowJs": true,
    "paths": {
      "@wordaholic/locales": ["../../app/shell/locales.js"],
      "@wordaholic/normalize": ["../../app/i18n/normalize.js"],
      "@wordaholic/storage": ["../../app/storage/idb.js"],
      "@wordaholic/help": ["../../app/help/dialog.js"],
      "@wordaholic/stats": ["../../app/stats/report.js"],
      "@wordaholic/updates": ["../../app/updates/manifest.js"],
      "@wordaholic/wordle-core": ["../../packages/wordle-core/src/index.ts"]
    }
  },
  "include": ["src", "../../packages/wordle-core/src", "../../app/shell/locales.js", "../../app/i18n/normalize.js", "../../app/storage/idb.js"]
}
