{
  "menu": "עברית",
  "flag": "🇮🇱",
  "rtl": true,
  "layout" : [
    ["", "", "ק", "ר", "א", "ט", "ו", "פ"],
    ["ש", "ד", "ג", "כ", "ע", "י", "ח", "ל"],
    ["ז", "ס", "ב", "ה", "נ", "מ", "צ", "ת"]
  ],
  "actions": {
    "enter": { "label": "אישור", "position": "end" },
    "backspace": { "label": "⌫", "position": "end", "row": 0 }
  },
  "normalization": {
    "ם": "מ",
    "ן": "נ",
    "ץ": "צ",
    "ף": "פ",
    "ך": "כ"
  },
  "plugins": [
    {
      "id": "hebrewFinalForms",
      "config": {
        "regularToFinal": {
          "מ" : "ם",
          "נ" : "ן",
          "צ" : "ץ",
          "פ" : "ף",
          "כ": "ך" 
        },
        "exceptions": []
      }
    }
  ],
  "winMessage": "מזל טוב! ניצחת!",
  "helpTip": "Words are entered right-to-left. Only valid Hebrew words are accepted.",
  "loseMessage": "התשובה הייתה: {word}",
  "about": {
    "contributorLabel": "תורמים",
    "rulesLabel": "חוקי המשחק",
    "contributor": "Alex Kaplinsky"
  }
}
